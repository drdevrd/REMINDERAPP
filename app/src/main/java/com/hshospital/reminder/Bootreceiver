package com.hshospital.reminder

import android.app.AlarmManager
import android.app.PendingIntent
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.os.Build

class BootReceiver : BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent) {
        if (intent.action != Intent.ACTION_BOOT_COMPLETED &&
            intent.action != "android.intent.action.QUICKBOOT_POWERON") return

        val prefs = context.getSharedPreferences("reminder_prefs", Context.MODE_PRIVATE)
        if (!prefs.getBoolean("is_running", false)) return

        val text        = prefs.getString("reminder_text", "") ?: return
        val intervalMin = prefs.getInt("interval_minutes", 1)
        val ringSec     = prefs.getInt("ring_duration_sec", 30)
        val nextTrigger = System.currentTimeMillis() + intervalMin * 60 * 1000L

        prefs.edit().putLong("next_trigger", nextTrigger).apply()

        val alarmIntent = Intent(context, AlarmReceiver::class.java)
        alarmIntent.putExtra("reminder_text", text)
        alarmIntent.putExtra("interval_minutes", intervalMin)
        alarmIntent.putExtra("ring_duration_sec", ringSec)

        val pi = PendingIntent.getBroadcast(
            context, 0, alarmIntent,
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
        val showPi = PendingIntent.getActivity(
            context, 0, Intent(context, MainActivity::class.java),
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )

        val am = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
        am.setAlarmClock(AlarmManager.AlarmClockInfo(nextTrigger, showPi), pi)

        // Restart persistent service
        val persistIntent = Intent(context, PersistentService::class.java)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            context.startForegroundService(persistIntent)
        } else {
            context.startService(persistIntent)
        }
    }
}
