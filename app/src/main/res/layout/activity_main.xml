<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REMINDER"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#E8EAF6"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Default: every 1 min, rings 30s"
            android:textSize="12sp"
            android:textColor="#5C6BC0"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- SLOT 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SLOT 1"
            android:textSize="11sp"
            android:textColor="#5C6BC0"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnRename1"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Reminder 1"
                android:textSize="11sp"
                android:backgroundTint="#1A237E"
                android:textColor="#9FA8DA"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnStop1"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:text="STOP"
                android:textSize="11sp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:enabled="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSlot1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶  Reminder 1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- SLOT 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SLOT 2"
            android:textSize="11sp"
            android:textColor="#5C6BC0"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnRename2"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Reminder 2"
                android:textSize="11sp"
                android:backgroundTint="#1A237E"
                android:textColor="#9FA8DA"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnStop2"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:text="STOP"
                android:textSize="11sp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:enabled="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSlot2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶  Reminder 2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- SLOT 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SLOT 3"
            android:textSize="11sp"
            android:textColor="#5C6BC0"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnRename3"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Reminder 3"
                android:textSize="11sp"
                android:backgroundTint="#1A237E"
                android:textColor="#9FA8DA"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnStop3"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:text="STOP"
                android:textSize="11sp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:enabled="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSlot3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="▶  Reminder 3"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <!-- BOTTOM CONTROLS -->
        <Button
            android:id="@+id/btnDefaultSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⚙  Set Defaults"
            android:textSize="13sp"
            android:backgroundTint="#263238"
            android:textColor="#90A4AE"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnStopAll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="■  STOP ALL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
